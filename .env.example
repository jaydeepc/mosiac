# ---------- Mosaic configuration ----------
# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mosaic?retryWrites=true&w=majority
MONGODB_DB=mosaic

# Auth
AUTH_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=jaydeep.c1@gmail.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Jaydeep
# Allow people to create their own accounts from the sign-in page (admin can always create users)
ALLOW_SELF_SIGNUP=false

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
APP_URL=http://localhost:3000
APP_NAME=Mosaic

# Models (swap freely; every stage reads from here)
# Writes resume text, questions, summaries, extraction  (multimodal: reads PDFs/images too)
MODEL_WRITER=google/gemini-3.8-flash
# Cheap fast model for light parsing / classification
MODEL_FAST=google/gemini-3.5-flash-lite
# Decisioning / routing model (is-this-you ranking, take-or-leave judgements, role inference)
MODEL_DECISION=typesafe/jev-router
# Web-grounded research (uses OpenRouter "web" plugin; engine native = Google grounding for Gemini)
MODEL_RESEARCH=google/gemini-3.8-flash
WEB_SEARCH_ENGINE=native
WEB_SEARCH_MAX_RESULTS=8
# Audio transcription (accepts input_audio)
MODEL_TRANSCRIBE=google/gemini-3.5-flash-lite
# Image generation (dedicated OpenRouter Image API)
MODEL_IMAGE=openai/gpt-image-2.5-sunburst
IMAGE_QUALITY=medium
IMAGE_FORMAT=webp

# Behaviour
QUESTION_BUDGET=4
MAX_UPLOAD_MB=15
# Optional: path to a Chrome/Chromium binary for PDF export (puppeteer downloads one by default)
# PUPPETEER_EXECUTABLE_PATH=
