# ---------- Mosaic configuration ----------
# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mosaic?retryWrites=true&w=majority
MONGODB_DB=mosaic

# Auth
AUTH_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=jaydeep.c1@gmail.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Jaydeep
# Allow people to create their own accounts from the sign-in page (admin can always create users)
ALLOW_SELF_SIGNUP=false

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
APP_URL=http://localhost:3000
APP_NAME=Mosaic

# Models (swap freely; every stage reads from here)
# Writes resume text, questions, summaries, extraction (text + image input; PDFs go through the file-parser plugin)
MODEL_WRITER=z-ai/glm-5.3-flash
# Fast model for light parsing / classification / live draft lines
MODEL_FAST=z-ai/glm-5.3-flash
# Decisioning / routing model (is-this-you ranking, take-or-leave judgements, role inference)
MODEL_DECISION=typesafe/jev-router
# Web research via OpenRouter "web" plugin. engine exa = Exa index (works with any model, and is the one that holds LinkedIn profile text); native only works for Google/OpenAI/Anthropic/Perplexity/xAI models
MODEL_RESEARCH=z-ai/glm-5.3-flash
WEB_SEARCH_ENGINE=exa
WEB_SEARCH_MAX_RESULTS=8
# Audio transcription — must accept input_audio (qwen/qwen3.8-omni-flash, mistralai/voxtral-small-24b-2507, openai/gpt-audio-mini)
MODEL_TRANSCRIBE=qwen/qwen3.8-omni-flash
# Image generation (dedicated OpenRouter Image API)
MODEL_IMAGE=openai/gpt-image-2.5-sunburst
IMAGE_QUALITY=medium
IMAGE_FORMAT=webp

# Behaviour
QUESTION_BUDGET=4
MAX_UPLOAD_MB=15
# Optional: path to a Chrome/Chromium binary for PDF export (puppeteer downloads one by default)
# PUPPETEER_EXECUTABLE_PATH=

# Optional: Chromium pack used for PDF export on serverless hosts (defaults to the @sparticuz/chromium release matching package.json)
# CHROMIUM_PACK_URL=
